{
  "name": "Bambo Exam Practice",
  "short_name": "Bambo",
  "description": "Practise medical exam questions, review your mistakes and track your progress.",
  "id": "/user-dashboard",
  "start_url": "/user-dashboard?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F7F9",
  "theme_color": "#185FA5",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Review due questions", "url": "/mistakes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Subjects", "url": "/user", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
